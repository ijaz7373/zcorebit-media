# Zcorebit Media — Apache clean-URL + caching + compression config.
# Serves /about at /about/index.html with a 200 (no redirect) so
# there is nothing for search engines to follow through a 301.

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If a real file or directory exists at this path, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # /xyz.html requests are the old URL shape from before this rebuild.
  # Send them straight to the clean URL with a real 301 (the only
  # redirect on this site, and only for legacy inbound links/bookmarks)
  # so link equity consolidates on the clean URL instead of splitting.
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /about -> internally serve about/index.html, no redirect, URL stays clean.
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType video/mp4  "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html  "access plus 0 seconds"
</IfModule>

ErrorDocument 404 /404.html
