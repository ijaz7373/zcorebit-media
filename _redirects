# Netlify clean-URL config (only used if this site is ever moved to
# Netlify — primary hosting target is Apache/cPanel, see .htaccess).
# 200 = an internal rewrite, not a redirect: the browser URL stays
# clean and there is no 301 round-trip for these.
/about      /about/index.html      200
/services   /services/index.html   200
/work       /work/index.html       200
/contact    /contact/index.html    200
/privacy    /privacy/index.html    200
/terms      /terms/index.html      200

# Legacy .html links from before this rebuild — real 301s, the only
# redirects on the site, so any inbound link equity consolidates
# permanently onto the clean URL.
/about.html      /about      301!
/services.html   /services   301!
/work.html       /work       301!
/contact.html    /contact    301!
/privacy.html    /privacy    301!
/terms.html      /terms      301!

